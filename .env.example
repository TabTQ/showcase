# Copy to .env (never commit it). In a value, every $ must be doubled ($$) for docker compose. This matters for the password hash.

# --- Login ---
# bcrypt hash of the admin password. Make it with:
#   docker compose build && docker run --rm -it showcase-docs:local hash-password
# then double every $ before you paste it here.
DOCS_PASSWORD_HASH=
# all (default): everything needs the login. edit: same for the editor API. none: no login at all, only for a closed test setup.
DOCS_AUTH_MODE=all
# Extra names the editor answers to, comma separated, such as docs.example.com. IP addresses and localhost always work.
DOCS_ALLOWED_HOSTS=
# true only when EVERY way you open the editor is https (for example behind a reverse proxy with TLS).
DOCS_SECURE_COOKIES=false

# --- Network ---
# The address the port is published on. The default keeps it on this machine only. Use 0.0.0.0 only on a trusted network.
DOCS_BIND=127.0.0.1
DOCS_PORT=3020

# --- Limits ---
# Largest image or attachment, in MB.
DOCS_MAX_ASSET_MB=20
# Largest uploaded webapp (an HTML file or a zip), in MB.
DOCS_MAX_BUNDLE_MB=25
# Java memory options for the container.
DOCS_JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -Xss512k

# --- GitHub Pages publishing ---
# Turn it on once the other GH values are set. Start with DOCS_GH_DRY_RUN=true to see the site written to disk first.
DOCS_GH_ENABLED=false
# owner/name of the repository. The app owns the whole branch below and replaces its content on every sync.
DOCS_GH_REPO=
# The branch GitHub Pages serves. It is created by the first publish.
DOCS_GH_BRANCH=gh-pages
# Fine-grained personal access token for that one repository only: Contents read and write, Pages read. Never commit it.
DOCS_GH_TOKEN=
# Only for a custom domain. Default: https://<owner>.github.io/<name>/
DOCS_GH_SITE_URL=
# true: write the site into the data volume (folder github-dry-run) and send nothing to GitHub.
DOCS_GH_DRY_RUN=false
# Only for tests or GitHub Enterprise. Default: https://api.github.com
DOCS_GH_API_URL=https://api.github.com
